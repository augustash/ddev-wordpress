#!/bin/bash

## Description: Run npm in the theme (wp-content/themes/ash-child, or $DDEV_THEME_DIR)
## Usage: npm [flags] [args]
## Example: "ddev npm ci" or "ddev npm install -D gulp-concat"

# DDEV_THEME_DIR lives in the container's environment, so resolve it there.
ddev exec --raw bash -c 'cd "/var/www/html/${DDEV_THEME_DIR:-wp-content/themes/ash-child}" && npm "$@"' npm "$@"
ddev mutagen sync 2>/dev/null
